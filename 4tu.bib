	keywords  = {Aerospace Engineering, FOS: Mechanical engineering, Feed-Forward Neural Networks, Microphones, wind tunnel experiments, flight experiments, Micro air vehicles, airspeed, angle of attack, wall pressure fluctuations, hydrodynamic pressure fluctuations},
	abstract  = {This contains the data used to train and validate models created as part of the research project: Microphones as Airspeed Sensors for Unmanned Aerial Vehicles. The research objective is to evaluate the feasibility of the concept of estimating the airspeed of a vehicle using the power spectral density of the recorded wall pressure fluctuations on the vehicle's surface. The data was collected by performing practical experiments and it is in the form of the recorded microphones' voltage signal. Included is the data gathered from both the wind tunnel and flight experiments, the datasets organized as used for the trainign and validation of the models, as well as the response curve of the microphones used (Sonion 8002). Lastly, the trained models are also added. A README file describing the contents and use of the files and definition of the used abbreviations and as well as the units of the parameeters are also included.},
	copyright = {Creative Commons Zero v1.0 Universal},
	note      = {Dataset}
}

